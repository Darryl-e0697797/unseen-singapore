{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "story_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "accuracy_class": {
      "type": "string",
      "enum": [
        "documented",
        "reconstructed",
        "schematic",
        "envisioned"
      ]
    },
    "source_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,79}$"
      }
    },
    "asset_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,79}$"
      }
    },
    "narratives": {
      "type": "object",
      "properties": {
        "public": {
          "type": "string",
          "minLength": 1
        },
        "student": {
          "type": "string",
          "minLength": 1
        },
        "engineer": {
          "type": "string",
          "minLength": 1
        },
        "planning": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "public",
        "student",
        "engineer",
        "planning"
      ],
      "additionalProperties": false
    },
    "commands": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "resetScene"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "focusAsset"
              },
              "asset_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,79}$"
              }
            },
            "required": [
              "type",
              "asset_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "setLayerVisibility"
              },
              "layer": {
                "type": "string",
                "enum": [
                  "surface",
                  "dtss",
                  "mrt"
                ]
              },
              "visible": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "layer",
              "visible"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "setCamera"
              },
              "preset": {
                "type": "string",
                "enum": [
                  "overview",
                  "underground",
                  "tunnel",
                  "rail"
                ]
              }
            },
            "required": [
              "type",
              "preset"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "showSection"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "enabled"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "traceSystem"
              },
              "system": {
                "type": "string",
                "const": "dtss"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "system",
              "enabled"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "showAnnotation"
              },
              "annotation_id": {
                "type": "string",
                "enum": [
                  "purpose",
                  "flow",
                  "depth",
                  "rail"
                ]
              }
            },
            "required": [
              "type",
              "annotation_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "showSource"
              },
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,79}$"
              }
            },
            "required": [
              "type",
              "source_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "setEra"
              },
              "era": {
                "type": "string",
                "const": "present"
              }
            },
            "required": [
              "type",
              "era"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "story_id",
    "title",
    "accuracy_class",
    "source_ids",
    "asset_ids",
    "narratives",
    "commands"
  ],
  "additionalProperties": false
}
